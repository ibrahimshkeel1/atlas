{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.local/bank-eval/expected.schema.json",
  "title": "Atlas bank statement expected transactions",
  "type": "object",
  "required": ["bank_name", "transactions"],
  "additionalProperties": false,
  "properties": {
    "bank_name": {
      "type": "string",
      "description": "Canonical bank label from Atlas Pakistan bank registry"
    },
    "statement_id": {
      "type": "string",
      "description": "Stable id matching the fixture folder name"
    },
    "source": {
      "type": "string",
      "enum": ["synthetic", "redacted_real"],
      "description": "synthetic = generated for CI; redacted_real = real PDF with PII removed"
    },
    "privacy": {
      "type": "string",
      "enum": ["public", "private"],
      "description": "public may be committed; private must stay local / CI secrets"
    },
    "currency": {
      "type": "string",
      "default": "PKR"
    },
    "opening_balance": {
      "type": ["string", "null"],
      "description": "Optional opening balance as decimal string"
    },
    "closing_balance": {
      "type": ["string", "null"],
      "description": "Optional stated closing balance for reconciliation"
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": { "type": "string", "format": "date" },
        "end": { "type": "string", "format": "date" }
      }
    },
    "transactions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["transaction_date", "description"],
        "additionalProperties": false,
        "properties": {
          "transaction_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "description": { "type": "string", "minLength": 1 },
          "debit": {
            "type": ["string", "null"],
            "description": "Debit amount as decimal string, or null"
          },
          "credit": {
            "type": ["string", "null"],
            "description": "Credit amount as decimal string, or null"
          },
          "balance": {
            "type": ["string", "null"],
            "description": "Running balance after this row, if known"
          },
          "reference": {
            "type": ["string", "null"]
          }
        }
      }
    }
  }
}
