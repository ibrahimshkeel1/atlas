# Copy to .env.staging and fill before: docker compose -f docker-compose.staging.yml --env-file .env.staging up --build -d

POSTGRES_PASSWORD=replace-with-strong-db-password
JWT_SECRET=replace-with-long-random-secret-at-least-32-chars
FILE_SIGNING_SECRET=replace-with-different-long-random-secret
REQUIRE_SECURE_SECRETS=true

S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=replace-with-strong-minio-secret
S3_BUCKET=atlas-documents
S3_REGION=us-east-1

API_PORT=8000
WEB_PORT=3000
API_PUBLIC_URL=https://api.your-pilot-domain.com
API_CORS_ORIGINS=https://app.your-pilot-domain.com
NEXT_PUBLIC_APP_URL=https://app.your-pilot-domain.com

# heuristic is free + deterministic for pilots; switch to gemini/openai/auto when ready
AI_PROVIDER=heuristic
OPENAI_API_KEY=
GEMINI_API_KEY=
CONFIDENCE_REVIEW_THRESHOLD=0.7
MAX_UPLOAD_MB=20
STORAGE_BACKEND=s3
