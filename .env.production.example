# Production: Vercel (web) + Supabase (Postgres) + container host (API)
# Copy values into each platform's dashboard — do not commit real secrets.

# ─── Supabase Postgres ───────────────────────────────────────────────
# Project Settings → Database → Connection string
# Prefer "Transaction" pooler (port 6543) for the API service.
# Paste either postgres:// or postgresql:// — Atlas normalizes to psycopg.
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# ─── Supabase Storage (S3-compatible) OR any S3 ──────────────────────
STORAGE_BACKEND=s3
# Storage → S3 Access Keys in Supabase dashboard
S3_ENDPOINT_URL=https://[PROJECT_REF].supabase.co/storage/v1/s3
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=atlas-documents
S3_REGION=us-east-1

# ─── API host (Railway / Fly / Render) ───────────────────────────────
# Public HTTPS URL of the FastAPI service
API_PUBLIC_URL=https://atlas-api.up.railway.app
API_CORS_ORIGINS=https://your-app.vercel.app,https://your-custom-domain.com
REQUIRE_SECURE_SECRETS=true
JWT_SECRET=replace-with-long-random-secret-at-least-32-chars
FILE_SIGNING_SECRET=replace-with-different-long-random-secret-32+
REDIS_URL=redis://default:[PASSWORD]@[HOST]:[PORT]
AI_PROVIDER=auto
GEMINI_API_KEY=
OPENAI_API_KEY=
MAX_UPLOAD_MB=20
CONFIDENCE_REVIEW_THRESHOLD=0.7

# ─── Vercel (apps/web) ───────────────────────────────────────────────
# Project → Settings → Environment Variables
# Root Directory must be: apps/web
API_URL=https://atlas-api.up.railway.app
NEXT_PUBLIC_API_URL=https://atlas-api.up.railway.app
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
