# Local zero-Docker defaults (swap to Postgres/S3 when using Docker)
DATABASE_URL=sqlite+pysqlite:///./data/atlas.db
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/storage
API_PUBLIC_URL=http://localhost:8000

REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-to-a-long-random-secret
FILE_SIGNING_SECRET=
REQUIRE_SECURE_SECRETS=false
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=atlas-documents
S3_REGION=us-east-1

OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o

# Google AI Studio key (AIza…). For true Vertex use GCP ADC + project instead.
AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
VERTEX_MODEL=gemini-2.0-flash-001
GOOGLE_APPLICATION_CREDENTIALS=data/gcp-sa.json

API_CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_URL=http://localhost:8000
MAX_UPLOAD_MB=20
CONFIDENCE_REVIEW_THRESHOLD=0.7
